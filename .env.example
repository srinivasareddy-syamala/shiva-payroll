# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.
# On Dokploy, paste these lines into the app's Environment tab instead.

# Database password. If the database already exists, this MUST be the password it was created with.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=postgres
POSTGRES_DB=shiva_payroll

# Long random text used to sign logins (changing it logs everyone out once)
SECRET_KEY=change-me-to-a-long-random-string

COMPANY_NAME=Shiva Agrovet
COMPANY_ADDRESS=

# Only needed for the very first start of an empty database (creates the first owner login)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Local PC only: port for http://localhost:<port>
WEB_PORT=5000
